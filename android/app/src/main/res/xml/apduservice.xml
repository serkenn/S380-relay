<?xml version="1.0" encoding="utf-8"?>
<!--
  HCE routing table. Android hands the SELECT (and following APDUs) to this app
  only when the terminal's SELECT AID matches an entry below.

  The relayed card was identified as a Japanese Individual Number Card
  (マイナンバーカード): all four applets answered 9000. Their AIDs are
  registered here so a reader that selects them is routed to the relay.
  The D392 prefixes catch variants; a few generic AIDs remain for other cards.

  category="other" = non-payment. On some devices you must enable this app under
  Settings > Connected devices > NFC.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/service_desc"
    android:requireDeviceUnlock="false">

    <aid-group
        android:category="other"
        android:description="@string/aid_group_desc">

        <!-- Individual Number Card (My Number) applets -->
        <aid-filter android:name="D3921000310001010408" />  <!-- 券面事項入力補助AP -->
        <aid-filter android:name="D3921000310001010402" />  <!-- 券面事項確認AP -->
        <aid-filter android:name="D392F000260100000001" />  <!-- JPKI 公的個人認証AP -->
        <aid-filter android:name="D3921000310001010100" />  <!-- 住基AP -->
        <!-- Prefixes to catch other My Number applets / selection by partial AID -->
        <aid-filter android:name="D3921000310001*" />
        <aid-filter android:name="D392F0002601*" />

        <!-- Generic test / fallback AIDs -->
        <aid-filter android:name="A000000003*" />
        <aid-filter android:name="A0000000031010" />
        <aid-filter android:name="D2760000850101" />

    </aid-group>
</host-apdu-service>
